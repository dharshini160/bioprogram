from Bio import pairwise2
sequences = [
   "ATGCT",
   "ATGTT",
   "ATCCT"
]
for i in range(len(sequences)):
   for j in range(i + 1, len(sequences)):
       seq1 = sequences[i]
       seq2 = sequences[j]
       alignments = pairwise2.align.globalms(seq1, seq2, 1, 0, -1, -1)
       best_alignment = alignments[0]
       print("Alignment between Sequence", i+1, "and Sequence", j+1)
       print("Sequence 1:", best_alignment.seqA)
       print("Sequence 2:", best_alignment.seqB)
       print("Score:", best_alignment.score)
       print("-" * 40)
